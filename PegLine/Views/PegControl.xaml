<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="PegLine.Views.PegControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="124"
    Height="158"
    IsTabStop="False"
    UseLayoutRounding="True">
    <Grid
        x:Name="Card"
        RenderTransformOrigin="0.5,0"
        PointerEntered="Card_PointerEntered"
        PointerExited="Card_PointerExited"
        PointerPressed="Card_PointerPressed"
        PointerMoved="Card_PointerMoved"
        PointerReleased="Card_PointerReleased">
        <Grid.RenderTransform>
            <RotateTransform x:Name="Spin" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Width="22" Height="18" HorizontalAlignment="Center" IsHitTestVisible="False">
            <Border Width="9" Height="16" Margin="0,1,8,0" HorizontalAlignment="Left" Background="#C8956C" CornerRadius="1" />
            <Border Width="9" Height="16" Margin="8,1,0,0" HorizontalAlignment="Right" Background="#E4C4A0" CornerRadius="1" />
            <Border Width="4" Height="9" VerticalAlignment="Center" Background="#6E737A" CornerRadius="2" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,-2,0,0">
            <Border Margin="4,5,0,0" Background="#33000000" CornerRadius="3" />
            <Border Background="#F7F1E8" BorderBrush="#E4D3BC" BorderThickness="1" CornerRadius="3" Padding="6,6,6,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="86" />
                        <RowDefinition Height="16" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#E7DCCB">
                        <Image x:Name="Photo" Stretch="UniformToFill" />
                        <TextBlock
                            x:Name="Placeholder"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#6F6256"
                            FontSize="12"
                            Text="…" />
                    </Grid>
                    <TextBlock
                        x:Name="Caption"
                        Grid.Row="1"
                        Margin="0,3,0,0"
                        FontFamily="Microsoft YaHei UI"
                        FontSize="10"
                        Foreground="#6F6256"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
            <Button
                x:Name="CloseButton"
                Width="22"
                Height="22"
                Margin="0,-6,-4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Opacity="0"
                Click="Close_Click"
                PointerPressed="Close_PointerPressed">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#F7F1E8" BorderBrush="#8C4A2F" BorderThickness="1" CornerRadius="11">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,-2,0,0"
                                FontSize="14"
                                Foreground="#2C2416"
                                Text="×" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</UserControl>
