<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PegLine</RootNamespace>
    <AssemblyName>PegLine</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Assets\PegLine.ico</ApplicationIcon>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AssemblyTitle>PegLine</AssemblyTitle>
    <Product>PegLine 挂绳</Product>
    <Description>A screenshot clothesline for Windows. Images stay on this PC.</Description>
    <Version>1.0.3</Version>
    <Company>PegLine</Company>
    <!-- Drop unused culture satellites from a self-contained publish. UI copy is zh-CN. -->
    <SatelliteResourceLanguages>zh-CN;zh-Hans;en</SatelliteResourceLanguages>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x86'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'ARM64' or '$(Platform)' == 'arm64')">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>


  <!-- Applied when publishing Release (see scripts/publish-installer.ps1). Debug F5 stays lightweight. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(PublishDir)' != ''">
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <!-- ReadyToRun compiles the whole self-contained framework to native images.
         That grows the installer and the mapped working set; this tray app does not need it. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PegLine.Core\PegLine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\PegLine.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
